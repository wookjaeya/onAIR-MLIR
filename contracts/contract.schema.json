{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OnAIR AI plugin deployment contract",
  "description": "Split per reviewer issue m2: this file describes the MODEL/ARTIFACT only. System-level schedulability belongs in analysis_report.json, not here.",
  "type": "object",
  "required": ["model", "interface", "target", "resources", "timing", "artifact"],
  "properties": {
    "model": {"type": "object", "required": ["name", "sha256"], "properties": {
      "name": {"type": "string"}, "sha256": {"type": "string"}, "version": {"type": "string"}}},
    "interface": {"type": "object", "required": ["input", "output"], "properties": {
      "input": {"$ref": "#/$defs/tensor"}, "output": {"$ref": "#/$defs/tensor"}}},
    "target": {"type": "object", "required": ["triple", "profile"], "properties": {
      "triple": {"type": "string"}, "cpu": {"type": "string"},
      "profile": {"enum": ["fast", "predictable", "memory"]},
      "driver": {"type": "string"}, "extra_args": {"type": "array", "items": {"type": "string"}}}},
    "resources": {"type": "object", "properties": {
      "peak_memory_bytes": {"type": ["integer", "null"]},
      "binary_size_bytes": {"type": "integer"}}},
    "timing": {"type": "object", "required": ["boundary", "bound_method"], "properties": {
      "boundary": {"enum": ["L1_kernel", "L2_plugin", "L3_end_to_end"],
                   "description": "Reviewer issue C3: a bound is meaningless without its measurement boundary."},
      "execution_bound_us": {"type": ["number", "null"]},
      "bound_method": {"enum": ["measured_max", "measured_with_margin", "static_wcet", null],
                       "description": "measured_max is NOT a WCET. Level A/B/C must never be conflated."},
      "sample_count": {"type": ["integer", "null"]},
      "platform_timing_grade": {"enum": ["PASS", "FUNCTIONAL_ONLY"]}}},
    "artifact": {"type": "object", "required": ["file", "sha256"], "properties": {
      "file": {"type": "string"}, "sha256": {"type": "string"}}}
  },
  "$defs": {"tensor": {"type": "object", "required": ["shape", "dtype"], "properties": {
    "shape": {"type": "array", "items": {"type": "integer"}}, "dtype": {"type": "string"}}}}
}
